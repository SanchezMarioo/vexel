# ── Sanity CMS (blog) ───────────────────────────────────────────────
# Copia a .env.local y rellena. NUNCA commitees valores reales.
# Los tres primeros son públicos (se inlinean en el cliente del Studio).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Token de SOLO lectura (server): permite leer borradores en Draft Mode.
SANITY_API_READ_TOKEN=

# Secreto compartido para el webhook de revalidación y para activar Draft Mode.
SANITY_REVALIDATE_SECRET=

# (Opcional, solo para scripts/seed-sanity.mts) Token con permiso de escritura.
SANITY_API_WRITE_TOKEN=

# Persistencia de leads (solo servidor; nunca NEXT_PUBLIC_*).
# Webhook de Google Apps Script → Google Sheets (mismo que usa /api/contact).
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=

# Emails transaccionales del funnel (solo servidor; proveedor Resend vía API HTTP).
# El enlace de reserva NO se configura aquí: sale de identity.calUrl (Cal.com).
RESEND_API_KEY=
LEADS_EMAIL_FROM=
LEADS_INTERNAL_EMAIL=contacto@xync.es
