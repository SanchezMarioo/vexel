# ── Sanity CMS (blog) ───────────────────────────────────────────────
# Copia a .env.local y rellena. NUNCA commitees valores reales.
# Los tres primeros son públicos (se inlinean en el cliente del Studio).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Token de SOLO lectura (server): permite leer borradores en Draft Mode.
SANITY_API_READ_TOKEN=

# Secreto compartido para el webhook de revalidación y para activar Draft Mode.
SANITY_REVALIDATE_SECRET=

# (Opcional, solo para scripts/seed-sanity.mts) Token con permiso de escritura.
SANITY_API_WRITE_TOKEN=

# ── Supabase (Base de datos principal de leads) ───────────────────────
# URL y anon key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role key (NUNCA exponer en cliente, solo servidor para bypass de RLS controlado)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Clerk Auth (Dashboard privado /admin) ──────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/admin/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/admin/login
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/admin/leads
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/admin/leads

# Lista blanca de emails de administradores autorizados (separados por coma)
ADMIN_EMAILS=contacto@xync.es

# ── Emails transaccionales del funnel (Resend) ────────────────────────
RESEND_API_KEY=
LEADS_EMAIL_FROM="Xync <contacto@xync.es>"
LEADS_INTERNAL_EMAIL=contacto@xync.es

# ── Notificaciones de Telegram (Nuevos leads) ─────────────────────────
# Token del bot creado con @BotFather (NUNCA exponer en cliente)
TELEGRAM_BOT_TOKEN=
# Chat ID del canal o grupo donde se envían las alertas (ej. -1004311554226)
TELEGRAM_CHAT_ID=-1004311554226

# ── URL pública de la aplicación ──────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://www.xync.es

